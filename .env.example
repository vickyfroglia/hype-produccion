NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-O-PUBLISHABLE-KEY

# --- Reporte diario por mail (ver README, sección "Reporte diario por mail") ---
# Service Role de Supabase (Project Settings > API > service_role secret).
# OJO: nunca le pongas el prefijo NEXT_PUBLIC_, tiene que quedar solo del lado del servidor.
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY

# Cuenta de Gmail/Google Workspace desde la que se manda el reporte, y su
# "contraseña de aplicación" (no la contraseña normal de la cuenta).
GMAIL_USER=ventas@hypearg.com
GMAIL_APP_PASSWORD=TU-CONTRASENA-DE-APLICACION

# A quién le llega el reporte (separados por coma si son varios).
REPORTE_DESTINATARIOS=matias@hypearg.com

# Mismo valor que el que pusiste en vercel.json (crons > path > ?secret=...),
# para que el endpoint solo responda cuando lo llama el cron de Vercel.
CRON_SECRET=TU-SECRETO-DEL-CRON
